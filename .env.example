# Template for the local .env file. Copy to .env and fill in real values:
#
#   cp .env.example .env      # Linux / macOS
#   Copy-Item .env.example .env   # Windows PowerShell
#
# .env is git-ignored and must never be committed. docker compose reads it
# from the repository root automatically; the Go services do not load it by
# themselves — export the variables in the shell before running them.

# ---------------------------------------------------------------------------
# RabbitMQ (used by docker-compose.yml)
# ---------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---------------------------------------------------------------------------
# User Service (prefix USER_SERVICE_*)
# ---------------------------------------------------------------------------
# Mandatory: the service refuses to start without it. The database runs in
# Docker (docker compose up -d user-db); user-service applies its own
# migrations at startup, so no manual schema setup is needed.
USER_SERVICE_DB_DSN=host=127.0.0.1 port=5432 user=library password=library dbname=library_users sslmode=disable

# First librarian. Set both values on a fresh database, leave them empty in
# production after the first administrator exists.
USER_SERVICE_SEED_LIBRARIAN_EMAIL=
USER_SERVICE_SEED_LIBRARIAN_PASSWORD=

# ---------------------------------------------------------------------------
# Book Service (prefix BOOK_SERVICE_*)
# ---------------------------------------------------------------------------
# Book Service still uses the in-memory repository; PostgreSQL DSN appears
# here when its storage is switched (issue #4).
