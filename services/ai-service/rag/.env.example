# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#   Copy-Item .env.example .env
#
# NEVER commit `.env`. It is referenced by docker-compose.yml and documented in
# docs/SETUP.md. The defaults below are placeholders, not working secrets.
# ---------------------------------------------------------------------------

# --- Postgres / pgvector container -----------------------------------------
# Docker owns these values; the container creates this user and database on the
# FIRST start only (when the pgdata volume is empty). Changing them later does
# not change the existing database.
POSTGRES_USER=bookrag

# REQUIRED. Use a strong value. If it contains $ # " or other shell characters,
# quote it inside docker-compose (already done) and URL-encode it for n8n.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

POSTGRES_DB=bookrag

# Host port. 5433 by deliberate choice: 5432 belongs to your existing Postgres.
POSTGRES_PORT=5433

# --- Values you plug into the n8n Postgres credential ----------------------
# n8n credential type: Postgres
#   Host        localhost
#   Database    bookrag
#   User        bookrag
#   Password    <same as POSTGRES_PASSWORD above>
#   Port        5433
#   SSL         disable   (local container, not exposed beyond this machine)

# --- Model configuration ---------------------------------------------------
# Use the free Google AI Studio key.
#
# EMBEDDING width is 3072, and that is NOT arbitrary:
#   * n8n's "Embeddings Google Gemini" node offers NO dimension setting.
#   * gemini-embedding-001 and gemini-embedding-2 both emit 3072 by default.
# So the database column is vector(3072). If you ever change the model or find a
# way to request a smaller width, the column and every stored vector must change
# with it (see docs/DECISIONS.md ADR-002). Google recommends 768/1536/3072 as
# valid MRL widths, but only 3072 is reachable from this n8n node.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=3072

# Agent chat model. See docs/DECISIONS.md ADR-001 and ADR-006.
#   Recommended working free option: Groq's OpenAI-compatible endpoint.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Webhook authentication (recommended) ----------------------------------
# Create an n8n "Header Auth" credential with these values, and attach it to the
# Webhook node. Header name and value can be anything you choose.
WEBHOOK_HEADER_NAME=x-book-rag-key
WEBHOOK_HEADER_VALUE=change-me-too
